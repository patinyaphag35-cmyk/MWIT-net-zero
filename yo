          <p>${escapeHTML(item.desc)}</p>
          <p class="small">เป็นค่าจำลองเพื่อการเรียนรู้ ค่าจริงขึ้นกับขนาด อายุ สุขภาพ อัตรารอด และสภาพภูมิอากาศ</p>`
        :`<p><strong>หน้าที่:</strong> ${escapeHTML(item.desc)}</p>
          <p><strong>รายได้:</strong> ${money(Math.round(item.income*(asset.upgraded?1.08:1)))} ต่อ 10 วินาที</p>
          <p><strong>การปล่อย:</strong> ${Math.round(item.emission*(asset.upgraded?.75:1))} kgCO₂e</p>
          <p class="small">แบบจำลองจากไฟฟ้า ${item.kwh} kWh × ${CONFIG.ELECTRICITY_EF} kgCO₂e/kWh</p>`;

      const upgradeText=item.kind==="tree"
        ?"ดูแลต้นไม้ ฿45 — เพิ่มการดูดซับ 20%"
        :"ปรับปรุงอาคาร ฿100 — ลดการปล่อย 25% เพิ่มรายได้ 8%";

      openModal(`
        <h2>${item.icon} ${escapeHTML(item.name)}</h2>
        ${detail}
        <div class="actions">
          ${asset.upgraded
            ?'<button class="btn" disabled>อัปเกรดแล้ว</button>'
            :`<button id="upgradeAsset" class="btn primary">${upgradeText}</button>`}
          ${asset.starter
            ?'<button class="btn" disabled>ต้นไม้เริ่มต้น รื้อไม่ได้</button>'
            :'<button id="demolishAsset" class="btn red">รื้อถอน — คืนเงิน 35%</button>'}
          <button id="closeAsset" class="btn">กลับเข้าเกม</button>
        </div>
      `);

      $("#closeAsset").onclick=resumeFromModal;

      const upgrade=$("#upgradeAsset");
      if(upgrade){
        upgrade.onclick=()=>{
          const cost=item.kind==="tree"?45:100;
          if(state.cash<cost){
            showToast("เงินไม่เพียงพอ");
            return;
          }
          state.cash-=cost;
          state.stats.spent+=cost;
          state.stats.upgraded++;
          asset.upgraded=true;
          if(item.kind==="tree")asset.object.scale.multiplyScalar(1.08);
          resumeFromModal();
          updateHUD();
          showToast("อัปเกรดสำเร็จ");
        };
      }

      const demolish=$("#demolishAsset");
      if(demolish){
        demolish.onclick=()=>{
          if(item.kind==="tree"){
            const loss=Math.round(item.absorb*(asset.upgraded?1.2:1));
            if(getMetrics().balance-loss<0){
              showToast("รื้อไม่ได้ เพราะจะทำให้สมดุลคาร์บอนติดลบ");
              return;
            }
          }
          const refund=Math.round(item.price*.35);
          removeAsset(asset);
          state.cash+=refund;
          resumeFromModal();
          updateHUD();
          showToast(`รื้อถอนแล้ว ได้เงินคืน ${money(refund)}`);
        };
      }
    }


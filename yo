    $("#submitQuiz").addEventListener("click",()=>{
      const form=$("#quizForm");
      const answers=[];
      let firstMissing=null;

      questions.forEach((_,i)=>{
        const checked=form.querySelector(`input[name="q_${i}"]:checked`);
        const box=form.querySelector(`[data-question="${i}"]`);
        box.classList.toggle("missing",!checked);
        if(!checked&&!firstMissing)firstMissing=box;
        answers.push(checked?Number(checked.value):null);
      });

      if(firstMissing){
        firstMissing.scrollIntoView({behavior:"smooth",block:"center"});
        showToast("กรุณาตอบคำถามให้ครบทุกข้อ");
        return;

    function addBox(parent,w,h,d,color,x,y,z,cast=true){
      const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material(color));
      mesh.position.set(x,y,z);
      mesh.castShadow=cast;
      mesh.receiveShadow=true;
      parent.add(mesh);
      return mesh;
    }

    function createBangkokMap(){
      const ground=new THREE.Mesh(new THREE.BoxGeometry(200,2,150),material(0x91c977));
      ground.position.y=-1;
      ground.receiveShadow=true;
      cityRoot.add(ground);

      const park=new THREE.Mesh(new THREE.CircleGeometry(19,48),material(0x65af62));
      park.rotation.x=-Math.PI/2;
      park.position.set(37,.07,-30);
      park.receiveShadow=true;
      cityRoot.add(park);

      riverPoints=[
        new THREE.Vector3(-38,.22,-78),new THREE.Vector3(-28,.22,-57),
        new THREE.Vector3(-34,.22,-34),new THREE.Vector3(-22,.22,-12),
        new THREE.Vector3(-28,.22,10),new THREE.Vector3(-16,.22,32),
        new THREE.Vector3(-22,.22,55),new THREE.Vector3(-11,.22,78)
      ];

      const sampled=new THREE.CatmullRomCurve3(riverPoints).getPoints(70);

      sampled.forEach((point,index)=>{
        if(index===sampled.length-1)return;
        const next=sampled[index+1];
        const length=point.distanceTo(next)+2.2;

        const water=new THREE.Mesh(
          new THREE.BoxGeometry(13,.26,length),
          new THREE.MeshStandardMaterial({
            color:0x239ad0,roughness:.25,metalness:.05,transparent:true,opacity:.9
          })
        );
        water.position.copy(point).lerp(next,.5);
        water.rotation.y=Math.atan2(next.x-point.x,next.z-point.z);
        water.receiveShadow=true;
        water.userData.water=true;
        cityRoot.add(water);
      });

      const roads=[
        [-82,-51,164,4,0],[-82,-4,164,4,0],[-82,42,164,4,0],
        [-66,-68,4,130,0],[-5,-68,4,130,0],[52,-68,4,130,0],
        [82,-68,4,130,0],[15,-67,3,130,.19],[-82,66,170,3,-.13]
      ];

      roads.forEach(([x,z,w,d,rotation])=>{
        const road=addBox(cityRoot,w,.22,d,0x47555a,x,.08,z,false);
        road.rotation.y=rotation;
        const line=addBox(cityRoot,w,.05,.2,0xf1d975,x,.23,z,false);
        line.rotation.y=rotation;
      });

      [-51,-4,42].forEach(createBridge);

      createStaticDistrict(-72,-50,3,3,0xddd2bc);
      createStaticDistrict(12,-55,4,3,0xd9e2e7);
      createStaticDistrict(58,10,3,4,0xd7dce7);
      createStaticDistrict(-73,25,3,3,0xe4d6c2);
      createStaticDistrict(22,50,4,2,0xd7e2dc);
      createStaticDistrict(72,-48,2,2,0xd9d4eb);

      createWatArun(-42,10);
      createTemple(-4,27);
      createMahanakhon(22,-22);
      createBaiyoke(53,22);
      createGiantSwing(-1,8);
      createIconSiam(-15,-28);

      for(let i=0;i<34;i++){
        const x=24+Math.random()*50;
        const z=-48+Math.random()*90;
        if(Math.hypot(x-37,z+30)<22)continue;
        createDecorTree(x,z,.65+Math.random()*.45);
      }

      for(let i=0;i<18;i++){
        const x=-86+Math.random()*32;
        const z=-65+Math.random()*125;
        if(distanceToRiver(x,z)<11)continue;
        createDecorTree(x,z,.65+Math.random()*.55);
      }
    }

    function createBridge(z){
      const x=riverXAtZ(z);
      addBox(cityRoot,30,.8,5,0xd4d0c7,x,1.05,z);
      addBox(cityRoot,30,.18,.3,0xffffff,x,1.52,z-2.15,false);
      addBox(cityRoot,30,.18,.3,0xffffff,x,1.52,z+2.15,false);
      for(let px=x-12;px<=x+12;px+=8)addBox(cityRoot,.7,2.2,.7,0xa8aaa8,px,-.1,z);

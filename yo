    function attemptPlacement(itemId,x,z,free=false){
      const item=itemMap[itemId];

      if(!free&&state.cash<item.price){
        showToast("เงินไม่เพียงพอ");
        return;
      }
      if(Math.abs(x)>92||Math.abs(z)>66){
        showToast("กรุณาสร้างภายในเขตแผนที่");
        return;
      }
      if(distanceToRiver(x,z)<8.3){
        showToast("ไม่สามารถสร้างกลางแม่น้ำเจ้าพระยาได้");
        return;
      }
      if(state.assets.some(asset=>Math.hypot(asset.x-x,asset.z-z)<5)){
        showToast("ตำแหน่งนี้ใกล้สิ่งปลูกสร้างอื่นเกินไป");
        return;
      }

      createPlayerAsset(itemId,x,z,{free});
      clearSelection();
      updateHUD();

      if(!state.ended)showToast(`${item.icon} สร้าง ${item.name} สำเร็จ`);
    }

    function createPlayerAsset(itemId,x,z,options={}){
      const item=itemMap[itemId];
      const asset={
        uid:`asset_${Date.now()}_${Math.random().toString(36).slice(2)}`,
        itemId,x,z,upgraded:false,starter:Boolean(options.starter)
      };

      if(!options.free&&!options.starter){
        state.cash-=item.price;
        state.stats.spent+=item.price;
        if(item.kind==="tree")state.stats.treesBought++;
        else state.stats.buildingsBought++;
      }

      const object=item.kind==="tree"
        ?createTreeModel(item)
        :createBuildingModel(item);

      object.position.set(x,0,z);
      object.traverse(child=>child.userData.assetId=asset.uid);
      object.userData.assetId=asset.uid;

      userRoot.add(object);
      asset.object=object;
      state.assets.push(asset);

      return asset;
    }

    function createTreeModel(item){
      const group=new THREE.Group();
      const seed=Number(item.id.replace(/\D/g,""))||1;
      const height=5.2+(seed%5)*.35;

      const trunk=new THREE.Mesh(
        new THREE.CylinderGeometry(.35,.52,height*.52,9),
        material(0x71472b)
      );
      trunk.position.y=height*.26;
      trunk.castShadow=true;
      group.add(trunk);

      const greens=[0x2f8e45,0x3ba151,0x4b9f4d,0x267f40,0x58aa55];
      const crownMaterial=material(greens[seed%greens.length]);

      if(item.id==="t11"){
        for(let i=0;i<7;i++){
          const leaf=new THREE.Mesh(new THREE.ConeGeometry(.55,3.4,5),crownMaterial);
          leaf.position.y=height*.82;
          leaf.rotation.z=Math.PI/2.7;
          leaf.rotation.y=i*(Math.PI*2/7);
          leaf.castShadow=true;
          group.add(leaf);
        }
      }else if(item.id==="t15"){
        for(let i=0;i<5;i++){
          const stem=new THREE.Mesh(
            new THREE.CylinderGeometry(.12,.18,height,7),material(0x779b42)
          );
          stem.position.set((i-2)*.33,height/2,(i%2)*.3);
          stem.castShadow=true;
          group.add(stem);

          const leaves=new THREE.Mesh(new THREE.ConeGeometry(1.1,3,8),crownMaterial);
          leaves.position.set((i-2)*.33,height*.8,(i%2)*.3);
          leaves.castShadow=true;
          group.add(leaves);
        }
      }else{
        const crown=new THREE.Mesh(new THREE.IcosahedronGeometry(2.15,1),crownMaterial);
        crown.position.set(0,height*.72,0);
        crown.scale.set(1.25,.85,1.1);
        crown.castShadow=true;
        group.add(crown);

        const side1=crown.clone();
        side1.scale.multiplyScalar(.72);
        side1.position.set(1.25,height*.76,.3);
        group.add(side1);

        const side2=crown.clone();
        side2.scale.multiplyScalar(.68);
        side2.position.set(-1.15,height*.75,-.2);
        group.add(side2);
      }

      const base=new THREE.Mesh(new THREE.CylinderGeometry(2.1,2.2,.22,20),material(0x4e9b50));
      base.position.y=.11;
      base.receiveShadow=true;
      group.add(base);

      return group;
    }

    function createBuildingModel(item){
      const group=new THREE.Group();
      const index=Number(item.id.replace(/\D/g,""))||1;
      const heights=[7,10,14,9,15,12,18,10,6,7,13,8];
      const colors=[
        0xd6e2e6,0xe6d49d,0x96b5c3,0xadb8bd,0xc6d1db,0xd9c7a0,
        0xa9b8cb,0xe1e7e7,0xb57c5d,0xd4a96f,0x88aeb3,0x9cc49d
      ];

      const height=heights[index-1]||10;
      const width=item.id==="b4"?9:6.5+(index%3);
      const depth=item.id==="b4"?11:6.5+(index%2)*1.5;

      const body=addBox(group,width,height,depth,colors[index-1]||0xcbd5d8,0,height/2,0);
      body.material.metalness=.1;

      const windowMaterial=new THREE.MeshStandardMaterial({
        color:0x91d0e8,roughness:.25,metalness:.3,
        emissive:0x153d4a,emissiveIntensity:.13
      });

      for(let y=2;y<height-1;y+=2.4){
        for(const side of [-1,1]){
          const windows=new THREE.Mesh(
            new THREE.BoxGeometry(width*.72,.75,.09),windowMaterial
          );
          windows.position.set(0,y,side*(depth/2+.05));
          group.add(windows);
        }
      }

      addBox(group,width*.45,.8,depth*.45,0x66747a,0,height+.4,0);

      if(item.id==="b4"){
        const chimney=new THREE.Mesh(
          new THREE.CylinderGeometry(.5,.65,5,12),material(0x7a7f80)
        );
        chimney.position.set(2.7,height+2.5,2.5);
        chimney.castShadow=true;
        group.add(chimney);
      }

      if(item.id==="b12"){
        const recycle=new THREE.Mesh(
          new THREE.TorusGeometry(1.2,.25,8,20),material(0x2f9c62)
        );
        recycle.position.set(0,height*.55,depth/2+.15);
        group.add(recycle);
      }

      return group;
    }


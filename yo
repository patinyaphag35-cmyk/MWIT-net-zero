<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#092e27">
  <title>MWIT Net-Zero Bangkok | ส30105 มนุษย์กับสิ่งแวดล้อม</title>
  <meta name="description" content="เกมจำลองเมืองกรุงเทพฯ สามมิติ เรียนรู้พื้นที่สีเขียวและ Carbon Net Zero">
  <link rel="icon" href="logo.png">
  <meta property="og:title" content="MWIT Net-Zero Bangkok">
  <meta property="og:description" content="สร้างกรุงเทพฯ ให้เติบโตควบคู่กับพื้นที่สีเขียว">
  <meta property="og:image" content="logo.png">

  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"
    }
  }
  </script>

  <style>
    :root{
      --green:#167c57;
      --green2:#2fb477;
      --dark:#092e27;
      --navy:#1c2f78;
      --lime:#c3e96e;
      --blue:#2379d8;
      --purple:#5b34b0;
      --red:#d94251;
      --orange:#e98b25;
      --text:#17362e;
      --muted:#63756d;
      --line:#d7e7dd;
      --shadow:0 15px 40px rgba(8,46,37,.14);
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      min-height:100vh;
      color:var(--text);
      background:
        radial-gradient(circle at 10% 0%,rgba(195,233,110,.28),transparent 30%),
        linear-gradient(180deg,#eff8f2,#e3eeea);
      font-family:system-ui,-apple-system,"Noto Sans Thai","Segoe UI",sans-serif;
    }

    button,input{font:inherit}
    button{touch-action:manipulation}
    a{color:#1769bd}
    .screen{display:none;min-height:100vh}
    .screen.active{display:block}
    .container{width:min(1120px,calc(100% - 24px));margin:auto;padding:28px 0 55px}
    .narrow{width:min(830px,calc(100% - 24px))}

    .hero{text-align:center;padding:14px 0}
    .school-mark{
      display:grid;
      place-items:center;
      width:118px;
      height:118px;
      margin:auto;
      padding:9px;
      border-radius:50%;
      background:#fff;
      box-shadow:var(--shadow);
    }
    .school-mark img{width:100%;height:100%;object-fit:contain}
    .school-mark.no-logo::after{content:"🏙️";font-size:52px}
    .school-line{margin-top:11px;color:var(--navy);font-weight:850;letter-spacing:.3px}

    h1,h2,h3,p{margin-top:0}
    h1{font-size:clamp(1.9rem,6.5vw,3.7rem);line-height:1.08;margin:12px 0 8px}
    h2{font-size:clamp(1.5rem,4vw,2.25rem)}
    h3{font-size:1.06rem}
    .subtitle{color:#526860;font-size:1.05rem;line-height:1.7}

    .panel{
      background:rgba(255,255,255,.96);
      border:1px solid rgba(255,255,255,.8);
      border-radius:22px;
      padding:clamp(18px,4vw,32px);
      box-shadow:var(--shadow);
      margin-bottom:20px;
    }

    .notice{
      padding:15px 17px;
      border-left:5px solid var(--green2);
      border-radius:14px;
      background:#ecfaf2;
      line-height:1.65;
      margin-bottom:19px;
    }
    .notice.warning{border-left-color:var(--orange);background:#fff7e8}
    .notice.info{border-left-color:var(--blue);background:#eef4ff}

    .field{margin-bottom:15px}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:15px}
    label{display:block;font-weight:800;margin-bottom:7px}
    input{
      width:100%;
      padding:13px 14px;
      border:1px solid #c7d8ce;
      border-radius:12px;
      background:#fff;
      outline:none;
    }
    input:focus{border-color:var(--green2);box-shadow:0 0 0 4px rgba(47,180,119,.14)}

    .checkbox{display:flex;align-items:flex-start;gap:10px;font-weight:500;line-height:1.55}
    .checkbox input{width:20px;height:20px;flex:none;margin-top:2px}

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:7px;
      border:0;
      border-radius:13px;
      padding:12px 17px;
      background:#e2ece6;
      color:#18372e;
      font-weight:850;
      text-decoration:none;
      cursor:pointer;
      transition:.17s transform,.17s filter;
    }
    .btn:hover{filter:brightness(.97);transform:translateY(-1px)}
    .btn:active{transform:translateY(1px)}
    .btn:disabled{opacity:.48;cursor:not-allowed;transform:none}
    .btn.primary{color:#fff;background:linear-gradient(135deg,var(--green2),var(--green))}
    .btn.form{color:#fff;background:linear-gradient(135deg,#7a43d6,#4c2ba8)}
    .btn.red{color:#fff;background:var(--red)}
    .btn.large{width:100%;padding:15px}
    .actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:18px}

    .topline{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:18px}
    .pill{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:8px 12px;
      border-radius:999px;
      color:#175d43;
      background:#e3f6ea;
      font-weight:850;
    }

    .question{
      padding:19px;
      margin-bottom:14px;
      border:1px solid var(--line);
      border-radius:17px;
      background:#fff;
    }
    .question.missing{border:2px solid var(--red);background:#fff8f8}
    .q-title{font-weight:900;line-height:1.55;margin-bottom:12px}
    .option{
      display:flex;
      align-items:flex-start;
      gap:10px;
      margin:8px 0;
      padding:11px 12px;
      border:1px solid #dce8e0;
      border-radius:12px;
      cursor:pointer;
      font-weight:500;
    }
    .option:hover{background:#effaf3;border-color:#8ed0a8}
    .option input{width:18px;height:18px;margin:2px 0 0;flex:none}

    .score-card{text-align:center}
    .score-number{color:var(--green);font-size:clamp(3rem,12vw,6rem);font-weight:950;line-height:1}
    .identity{font-size:1.06rem;font-weight:800;margin:14px 0}

    .result-mark{
      width:74px;
      height:74px;
      margin:0 auto 8px;
      display:grid;
      place-items:center;
      border-radius:50%;
      background:#fff;
      box-shadow:0 6px 18px rgba(8,46,37,.13);
      padding:6px;
    }
    .result-mark img{width:100%;height:100%;object-fit:contain}
    .result-mark.no-logo::after{content:"🌳";font-size:33px}

    /* GAME */
    #gameScreen{height:100vh;overflow:hidden;background:#091f1b}
    .game-app{
      height:100vh;
      display:grid;
      grid-template-rows:auto 1fr;
      padding:max(7px,env(safe-area-inset-top)) 8px max(7px,env(safe-area-inset-bottom));
    }
    .hud{
      display:grid;
      grid-template-columns:1.35fr repeat(5,minmax(105px,1fr));
      gap:7px;
      margin-bottom:7px;
      z-index:20;
    }
    .hud-box{
      min-height:61px;
      padding:9px 11px;
      color:#16372e;
      background:rgba(255,255,255,.95);
      border:1px solid rgba(255,255,255,.8);
      border-radius:14px;
      box-shadow:0 8px 22px rgba(0,0,0,.12);
    }
    .hud-brand{display:flex;align-items:center;gap:9px;font-weight:950;font-size:.98rem}
    .hud-brand .mark{
      width:37px;
      height:37px;
      flex:none;
      display:grid;
      place-items:center;
      border-radius:50%;
      background:#fff;
      box-shadow:0 2px 7px rgba(0,0,0,.12);
    }
    .hud-brand .mark img{width:100%;height:100%;object-fit:contain}
    .hud-brand .mark.no-logo::after{content:"🌿";font-size:19px}
    .hud-box small{display:block;color:var(--muted);font-weight:750}
    .hud-box strong{display:block;font-size:1.05rem}
    .hud-box.good strong{color:var(--green)}
    .hud-box.bad strong{color:var(--red)}

    .game-body{min-height:0;display:grid;grid-template-columns:minmax(255px,330px) 1fr;gap:8px}
    .shop{min-height:0;overflow:auto;padding:12px;border-radius:17px;background:#fff;box-shadow:var(--shadow)}
    .shop-sticky{position:sticky;top:-12px;z-index:3;padding:11px 0 9px;background:#fff}
    .filter-row{display:flex;gap:6px;margin-bottom:7px}
    .filter-row .btn{flex:1;padding:8px 5px;font-size:.86rem}
    .filter-row .btn.active{color:#fff;background:var(--green)}

    .shop-list{display:grid;gap:9px}
    .shop-card{
      padding:11px;
      border:1px solid var(--line);
      border-radius:14px;
      background:#fff;
      cursor:grab;
      user-select:none;
      transition:.15s;
    }
    .shop-card:hover,.shop-card.selected{
      border-color:var(--green2);
      background:#effbf4;
      box-shadow:0 7px 18px rgba(22,124,87,.12);
      transform:translateY(-1px);
    }
    .shop-card.cannot-buy{opacity:.55}
    .shop-top{display:flex;align-items:center;gap:8px}
    .shop-icon{width:37px;text-align:center;font-size:28px}
    .shop-name{font-weight:900;line-height:1.2}
    .shop-price{margin-left:auto;color:#9b6400;font-weight:900}
    .shop-meta{margin-top:7px;color:#576a62;font-size:.8rem;line-height:1.45}

    .map-shell{
      position:relative;
      min-width:0;
      min-height:0;
      overflow:hidden;
      border:3px solid rgba(255,255,255,.92);
      border-radius:19px;
      background:#bde8ff;
      box-shadow:var(--shadow);
    }
    #threeContainer{position:absolute;inset:0}
    #threeContainer canvas{display:block;width:100%;height:100%;touch-action:none;outline:none}

    .map-topbar{
      position:absolute;
      top:10px;
      left:10px;
      right:10px;
      z-index:10;
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:8px;
      pointer-events:none;
    }
    .map-chip{
      max-width:min(460px,72%);
      padding:9px 12px;
      border-radius:13px;
      color:#fff;
      background:rgba(7,40,33,.87);
      font-size:.8rem;
      line-height:1.45;
      pointer-events:auto;
    }
    .map-tools{display:flex;gap:6px;pointer-events:auto}
    .map-tools .btn{padding:9px 11px;background:rgba(255,255,255,.94)}

    .selected-bar{
      position:absolute;
      left:50%;
      bottom:15px;
      z-index:10;
      display:none;
      align-items:center;
      gap:10px;
      max-width:90%;
      padding:10px 13px;
      border-radius:15px;
      color:#fff;
      background:rgba(7,43,35,.92);
      transform:translateX(-50%);
    }
    .selected-bar.show{display:flex}
    .selected-bar .btn{padding:7px 10px}

    .event-counter{
      position:absolute;
      right:12px;
      bottom:13px;
      z-index:9;
      padding:9px 12px;
      border-radius:13px;
      color:#fff;
      background:rgba(8,46,39,.9);
      font-size:.85rem;
      font-weight:850;
      pointer-events:none;
    }

    .legend{
      position:absolute;
      left:10px;
      bottom:10px;
      z-index:8;
      max-width:230px;
      padding:8px 10px;
      border-radius:11px;
      background:rgba(255,255,255,.9);
      color:#315148;
      font-size:.72rem;
      line-height:1.45;
      pointer-events:none;
    }

    .modal-backdrop{
      position:fixed;
      inset:0;
      z-index:2000;
      display:none;
      place-items:center;
      padding:15px;
      background:rgba(5,24,20,.76);
      backdrop-filter:blur(5px);
    }
    .modal-backdrop.open{display:grid}
    .modal{
      width:min(700px,100%);
      max-height:91vh;
      overflow:auto;
      padding:clamp(19px,4vw,29px);
      border-radius:22px;
      background:#fff;
      box-shadow:0 30px 80px rgba(0,0,0,.4);
    }
    .feedback{margin-top:14px;padding:14px;border-radius:14px;background:#ebf8f0;line-height:1.65}
    .feedback.wrong{background:#fff0f1}
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}
    .event-card{
      min-height:150px;
      border:0;
      border-radius:18px;
      padding:12px;
      color:#fff;
      background:linear-gradient(145deg,#21805e,#0c3e32);
      font-weight:900;
      cursor:pointer;
    }
    .event-card.good{background:#198b54}
    .event-card.bad{background:#bd3a49}

    .toast{
      position:fixed;
      left:50%;
      bottom:20px;
      z-index:4000;
      max-width:90%;
      padding:11px 17px;
      border-radius:13px;
      color:#fff;
      background:#113b31;
      font-weight:850;
      text-align:center;
      opacity:0;
      pointer-events:none;
      transform:translate(-50%,15px);
      transition:.2s;
    }
    .toast.show{opacity:1;transform:translate(-50%,0)}

    .summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin:18px 0}
    .summary-box{
      padding:14px 8px;
      border:1px solid var(--line);
      border-radius:15px;
      background:#f0f8f3;
      text-align:center;
    }
    .summary-box small{display:block;color:var(--muted)}
    .summary-box strong{display:block;color:var(--green);font-size:1.4rem}

    .ai-box{
      padding:20px;
      border-radius:19px;
      color:#fff;
      background:linear-gradient(135deg,#0b3a30,#1d7255);
      line-height:1.7;
    }
    .answer-review{padding:16px;margin:11px 0;border:1px solid var(--line);border-radius:15px}
    .answer-review.correct{border-left:6px solid var(--green2)}
    .answer-review.wrong{border-left:6px solid var(--red)}
    .bar{height:12px;border-radius:99px;background:#dfe9e3;overflow:hidden}
    .bar span{display:block;height:100%;background:linear-gradient(90deg,var(--green2),var(--lime))}
    .small{font-size:.84rem;color:var(--muted)}

    .copy-box{
      margin-top:14px;
      padding:13px;
      border:1px dashed #b9cec3;
      border-radius:13px;
      background:#f7fbf8;
      text-align:left;
      font-size:.87rem;
      line-height:1.65;
      white-space:pre-wrap;
    }

    /* FORM EMBED */
    .form-panel{border-top:6px solid var(--purple)}
    .form-head{
      display:flex;
      align-items:center;
      gap:11px;
      flex-wrap:wrap;
      margin-bottom:13px;
    }
    .form-head h2{margin:0}
    .form-badge{
      padding:7px 12px;
      border-radius:999px;
      background:#efe8ff;
      color:#4c2ba8;
      font-weight:850;
      font-size:.85rem;
    }
    .checklist{
      margin:0 0 16px;
      padding:14px 17px;
      border-radius:14px;
      background:#f6f2ff;
      line-height:1.75;
    }
    .checklist ol{margin:0;padding-left:20px}
    .form-frame-wrap{
      position:relative;
      border:1px solid var(--line);
      border-radius:17px;
      overflow:hidden;
      background:#fff;
    }
    #formFrame{
      display:block;
      width:100%;
      height:1180px;
      border:0;
    }
    .form-placeholder{
      display:grid;
      place-items:center;
      gap:13px;
      padding:44px 20px;
      text-align:center;
      background:linear-gradient(145deg,#f7f4ff,#eef7f2);
    }
    .form-placeholder .icon{font-size:3rem}
    .form-fallback{
      margin-top:11px;
      padding:11px 14px;
      border-radius:12px;
      background:#fff8e8;
      font-size:.85rem;
      line-height:1.6;
    }

    @media(max-width:980px){
      .hud{grid-template-columns:repeat(3,1fr)}
      .hud-brand{grid-column:1/-1;min-height:46px}
      .game-body{grid-template-columns:240px 1fr}
    }

    @media(max-width:720px){
      #gameScreen{height:100dvh}
      .game-app{height:100dvh}
      .hud{display:flex;overflow-x:auto;padding-bottom:2px}
      .hud-box{min-width:125px;min-height:53px;padding:7px 9px}
      .hud-brand{min-width:205px}
      .game-body{grid-template-columns:1fr;grid-template-rows:210px 1fr}
      .shop{padding:9px}
      .shop-sticky{top:-9px;padding-top:8px}
      .shop-list{display:flex;overflow-x:auto;gap:8px;padding-bottom:4px}
      .shop-card{min-width:225px}
      .map-chip{font-size:.71rem;max-width:66%}
      .legend{display:none}
      .event-counter{bottom:62px}
      .grid2,.summary-grid{grid-template-columns:1fr 1fr}
      .cards{grid-template-columns:1fr}
      .event-card{min-height:80px}
      #formFrame{height:1500px}
    }

    @media(max-width:440px){
      .container{width:calc(100% - 16px);padding-top:16px}
      .school-mark{width:98px;height:98px}
      .map-tools{flex-direction:column}
      .map-tools .btn{font-size:.72rem;padding:7px}
    }

    @media print{
      body{background:#fff}
      .btn,.actions,.form-panel{display:none!important}
      .screen{display:none!important}
      .screen.active{display:block!important}
      .panel{box-shadow:none}
    }
  </style>
</head>
<body>

  <section id="welcomeScreen" class="screen active">
    <main class="container narrow">
      <div class="hero">
        <div class="school-mark" id="heroMark">
          <img src="logo.png" alt="ตราโรงเรียนมหิดลวิทยานุสรณ์"
               onerror="this.remove();document.getElementById('heroMark').classList.add('no-logo')">
        </div>
        <div class="school-line">โรงเรียนมหิดลวิทยานุสรณ์</div>
        <h1>MWIT Net-Zero Bangkok</h1>
        <p class="subtitle">
          ออกแบบกรุงเทพฯ สามมิติให้เติบโตทางเศรษฐกิจควบคู่กับพื้นที่สีเขียว<br>
          รายวิชา ส30105 มนุษย์กับสิ่งแวดล้อม
        </p>
      </div>

      <div class="panel">
        <div class="notice">
          <strong>ประกาศเรื่องข้อมูลส่วนบุคคล</strong><br>
          เว็บไซต์นี้ไม่บันทึกชื่อ ชั้น เลขที่ คะแนน หรือข้อมูลส่วนบุคคลลงฐานข้อมูล
          และไม่มีการส่งข้อมูลออกจากอุปกรณ์โดยอัตโนมัติ ข้อมูลอยู่ในหน่วยความจำชั่วคราว
          และหายไปทั้งหมดเมื่อปิดหรือโหลดหน้าเว็บใหม่
          คะแนนใช้ประกอบการส่งงานรายวิชา
          <strong>ส30105 มนุษย์กับสิ่งแวดล้อม</strong> เท่านั้น
          โดยผู้ใช้งานเป็นผู้กรอกคะแนนลงฟอร์มด้วยตนเองในขั้นตอนสุดท้าย
        </div>

        <form id="identityForm">
          <div class="field">
            <label for="fullName">ชื่อ–นามสกุล</label>
            <input id="fullName" maxlength="100" autocomplete="name" required placeholder="เช่น สมชาย ใจดี">
          </div>

          <div class="grid2">
            <div class="field">
              <label for="studentClass">ชั้น</label>
              <input id="studentClass" maxlength="20" required placeholder="เช่น ม.5/2">
            </div>
            <div class="field">
              <label for="studentNo">เลขที่</label>
              <input id="studentNo" type="number" min="1" max="99" required placeholder="เช่น 12">
            </div>
          </div>

          <label class="checkbox">
            <input id="privacyConsent" type="checkbox" required>
            <span>ฉันรับทราบว่าระบบไม่จัดเก็บข้อมูล และจะถ่ายภาพหน้าจอผลคะแนนก่อนออกจากเว็บไซต์</span>
          </label>

          <button class="btn primary large" type="submit" style="margin-top:18px">เริ่มทำ Pre-test</button>
        </form>
      </div>
    </main>
  </section>

  <section id="quizScreen" class="screen">
    <main class="container narrow">
      <div class="topline">
        <div>
          <span id="quizBadge" class="pill">📝 Pre-test</span>
          <h2 id="quizTitle" style="margin:10px 0 0">ความรู้ก่อนเล่นเกม</h2>
        </div>
        <strong id="quizProgress">0/20 ข้อ</strong>
      </div>

      <div id="quizNotice" class="notice warning"></div>
      <form id="quizForm"></form>
      <button id="submitQuiz" class="btn primary large" type="button">ส่งคำตอบ</button>
    </main>
  </section>

  <section id="preResultScreen" class="screen">
    <main class="container narrow">
      <div class="panel score-card">
        <div class="result-mark" id="preMark">
          <img src="logo.png" alt="ตราโรงเรียน"

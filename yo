    function inspectAsset(uid){
      if(state.paused||state.ended)return;

      const asset=state.assets.find(x=>x.uid===uid);
      if(!asset)return;

      const item=itemMap[asset.itemId];
      state.paused=true;

      const detail=item.kind==="tree"
        ?`<p><strong>ประเภท:</strong> ${escapeHTML(item.type)}</p>

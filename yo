    function getMetrics(){
      let absorption=state.absorptionBonus;
      let grossEmission=0;
      let income=0;

      state.assets.forEach(asset=>{
        const item=itemMap[asset.itemId];
        if(item.kind==="tree"){
          absorption+=item.absorb*(asset.upgraded?1.2:1);
        }else{
          grossEmission+=item.emission*(asset.upgraded?.75:1);
          income+=item.income*(asset.upgraded?1.08:1);
        }
      });

      income*=state.incomeMultiplier;
      const emission=Math.max(0,grossEmission-state.emissionOffset);

      return {
        absorption:Math.round(absorption),
        grossEmission:Math.round(grossEmission),
        emission:Math.round(emission),
        income:Math.round(income),
        balance:Math.round(absorption-emission)
      };
    }

    function updateHUD(){
      if(!state.assets)return;

      const metrics=getMetrics();

      $("#timeHud").textContent=formatTime(state.timeLeft);
      $("#cashHud").textContent=money(state.cash);
      $("#incomeHud").textContent=state.outageSeconds>0
        ?`ไฟดับ ${state.outageSeconds} วิ`
        :money(metrics.income);
      $("#carbonHud").textContent=`${metrics.absorption} / ${metrics.emission}`;
      $("#balanceHud").textContent=`${metrics.balance>=0?"+":""}${metrics.balance} kgCO₂e`;
      $("#balanceBox").classList.toggle("good",metrics.balance>=0);
      $("#balanceBox").classList.toggle("bad",metrics.balance<0);

      const nextEvent=CONFIG.EVENT_INTERVAL-(state.elapsed%CONFIG.EVENT_INTERVAL);
      $("#eventHud").textContent=nextEvent||CONFIG.EVENT_INTERVAL;

      state.stats.maxCash=Math.max(state.stats.maxCash,state.cash);
      state.stats.minimumBalance=Math.min(state.stats.minimumBalance,metrics.balance);

      renderShop($(".shop-filter.active")?.dataset.filter||"all");

      if(!state.ended&&(state.cash<0||metrics.balance<0)){
        finishGame(true,state.cash<0
          ?"เงินของเมืองต่ำกว่า 0"
          :"เมืองปล่อยคาร์บอนมากกว่าที่พื้นที่สีเขียวดูดซับได้");
      }
    }

    function gameTick(){
      if(state.paused||state.ended)return;

      state.timeLeft--;
      state.elapsed++;

      if(state.outageSeconds>0)state.outageSeconds--;

      if(state.elapsed%CONFIG.INCOME_INTERVAL===0&&state.outageSeconds<=0){
        const income=getMetrics().income;
        state.cash+=income;
        state.stats.incomeEarned+=income;
        if(income>0)showToast(`เมืองสร้างรายได้ ${money(income)}`);
      }

      updateHUD();
      if(state.ended)return;

      if(state.timeLeft<=0){
        finishGame(false,"เล่นครบเวลา 10 นาทีและรักษาเมืองไว้ได้");
        return;
      }

      if(state.elapsed%CONFIG.EVENT_INTERVAL===0)specialEvent();
    }

    function eventQuestion(){
      const indexed=questions.map((q,i)=>({q,i}));
      const hardWrong=indexed.filter(x=>x.q.hard&&result.preAnswers[x.i]!==x.q.a);
      const allWrong=indexed.filter(x=>result.preAnswers[x.i]!==x.q.a);
      const hard=indexed.filter(x=>x.q.hard);
      return randomOf(hardWrong.length?hardWrong:allWrong.length?allWrong:hard);
    }

    function specialEvent(){
      state.paused=true;
      const q=eventQuestion().q;

      const wrong=q.c.map((text,index)=>({text,index})).filter(choice=>choice.index!==q.a);
      const options=shuffle([{text:q.c[q.a],index:q.a},...shuffle(wrong).slice(0,2)]);

      openModal(`
        <span class="pill">⚡ สถานการณ์พิเศษ</span>
        <h2 style="margin-top:14px">ตอบคำถามเพื่อปกป้องกรุงเทพฯ</h2>
        <p><strong>${escapeHTML(q.q)}</strong></p>
        <div id="eventOptions">
          ${options.map((option,i)=>`
            <button class="btn large event-answer" data-answer="${option.index}"
                    style="margin:5px 0;text-align:left;justify-content:flex-start">
              ${String.fromCharCode(65+i)}. ${escapeHTML(option.text)}
            </button>
          `).join("")}
        </div>
        <div id="eventFeedback"></div>
      `);

      $(".event-answer").forEach(button=>{
        button.onclick=()=>{
          $(".event-answer").forEach(x=>x.disabled=true);

          if(Number(button.dataset.answer)===q.a){
            state.stats.eventsCorrect++;
            $("#eventFeedback").innerHTML=`
              <div class="feedback"><strong>✅ ถูกต้อง</strong><br>${escapeHTML(q.e)}</div>
              <p style="margin-top:15px"><strong>เลือกการ์ด 1 ใบ:</strong> มีการ์ดผลดี 2 ใบและผลเสีย 1 ใบ</p>
              <div id="rewardCards" class="cards"></div>
            `;
            renderRewardCards();
          }else{
            state.stats.eventsWrong++;
            const effect=applyBadEffect();
            $("#eventFeedback").innerHTML=`
              <div class="feedback wrong">
                <strong>❌ ยังไม่ถูกต้อง</strong><br>
                <strong>คำตอบที่ถูก:</strong> ${escapeHTML(q.c[q.a])}<br>
                ${escapeHTML(q.e)}<br><br>
                <strong>ผลกระทบต่อเมือง:</strong> ${escapeHTML(effect)}
              </div>
              <button id="continueEvent" class="btn primary large" style="margin-top:14px">กลับเข้าเมือง</button>
            `;
            $("#continueEvent").onclick=resumeFromModal;
          }
        };
      });
    }

    const goodEffects=[
      {title:"ทุนเมืองสีเขียว",icon:"💰",apply(){state.cash+=300;return "ได้รับงบสนับสนุน ฿300";}},
      {title:"ฟื้นฟูพื้นที่ชุ่มน้ำ",icon:"💧",apply(){state.absorptionBonus+=14;return "การดูดซับเพิ่มขึ้น 14 kgCO₂e";}},
      {title:"โซลาร์ชุมชน",icon:"☀️",apply(){state.emissionOffset+=12;return "ลดการปล่อยรวม 12 kgCO₂e";}},
      {title:"เศรษฐกิจสีเขียว",icon:"📈",apply(){state.incomeMultiplier*=1.1;return "รายได้จากอาคารเพิ่มขึ้น 10%";}},
      {title:"รับต้นไม้ฟรี",icon:"🌳",apply(){
        const tree=randomOf(trees);
        for(let attempt=0;attempt<40;attempt++){
          const x=-80+Math.random()*160;
          const z=-57+Math.random()*114;
          if(distanceToRiver(x,z)>9&&!state.assets.some(a=>Math.hypot(a.x-x,a.z-z)<6)){
            createPlayerAsset(tree.id,x,z,{free:true});
            return `ได้รับ ${tree.name} ฟรี 1 ต้น`;
          }
        }
        state.cash+=tree.price;
        return `พื้นที่ไม่พอ จึงได้รับเงินชดเชย ${money(tree.price)}`;
      }}
    ];

    const badEffects=[
      {title:"ไฟดับ",icon:"🔌",apply(){
        state.outageSeconds=Math.max(state.outageSeconds,30);
        return "อาคารหยุดสร้างรายได้ 30 วินาที";
      }},
      {title:"ภาษีคาร์บอน",icon:"🧾",apply(){state.cash-=220;return "เมืองต้องจ่ายเงิน ฿220";}},
      {title:"ภัยแล้ง",icon:"☀️",apply(){
        state.cash-=130;state.absorptionBonus-=5;
        return "จ่ายค่าดูแล ฿130 และการดูดซับลดลง 5 kgCO₂e";
      }},
      {title:"พายุรุนแรง",icon:"🌪️",apply(){
        const removable=state.assets.filter(asset=>!asset.starter);
        if(!removable.length){
          state.cash-=180;
          return "ไม่มีทรัพย์สินที่เสียหายได้ เมืองจ่ายค่าฟื้นฟู ฿180";
        }
        const lost=randomOf(removable);
        const name=itemMap[lost.itemId].name;
        removeAsset(lost);
        state.stats.destroyed++;
        return `${name} ได้รับความเสียหายและหายไปจากเมือง`;
      }}
    ];

    function applyBadEffect(){
      const effect=randomOf(badEffects);
      const message=`${effect.icon} ${effect.title}: ${effect.apply()}`;
      updateHUD();

      if(state.cash<0||getMetrics().balance<0){
        pendingGameOver=state.cash<0
          ?"เหตุการณ์ทำให้เงินของเมืองต่ำกว่า 0"
          :"เหตุการณ์ทำให้สมดุลคาร์บอนต่ำกว่า 0";
      }

      return message;
    }

    function renderRewardCards(){
      const choices=shuffle([
        ...shuffle(goodEffects).slice(0,2).map(effect=>({type:"good",effect})),
        {type:"bad",effect:randomOf(badEffects)}
      ]);

      $("#rewardCards").innerHTML=choices.map((_,i)=>`
        <button class="event-card" data-index="${i}">❓<br>การ์ดลึกลับ</button>
      `).join("");

      $("#rewardCards .event-card").forEach(card=>{
        card.onclick=()=>{
          const selected=choices[Number(card.dataset.index)];

          $("#rewardCards .event-card").forEach((element,index)=>{
            element.disabled=true;
            element.classList.add(choices[index].type);
            element.innerHTML=`${choices[index].effect.icon}<br>${escapeHTML(choices[index].effect.title)}`;
          });

          const message=selected.effect.apply();
          updateHUD();

          if(state.cash<0||getMetrics().balance<0){
            pendingGameOver="ผลจากการ์ดทำให้เงินหรือสมดุลคาร์บอนต่ำกว่า 0";
          }

          const box=document.createElement("div");
          box.innerHTML=`
            <div class="feedback ${selected.type==="bad"?"wrong":""}">
              <strong>${selected.type==="good"?"🎉 ผลดี":"⚠️ ผลเสีย"}</strong><br>${escapeHTML(message)}
            </div>
            <button id="continueCard" class="btn primary large" style="margin-top:14px">กลับเข้าเมือง</button>
          `;
          $("#rewardCards").after(box);
          $("#continueCard").onclick=resumeFromModal;
        };
      });
    }

    function calculateGameScore(){
      const metrics=getMetrics();
      return Math.max(0,Math.round(
        state.cash+
        metrics.balance*7+
        state.assets.filter(a=>itemMap[a.itemId].kind==="tree").length*25+
        state.stats.eventsCorrect*130-
        state.stats.eventsWrong*55
      ));
    }

    function intelligentSummary(){
      const metrics=getMetrics();
      const treeCount=state.assets.filter(a=>itemMap[a.itemId].kind==="tree").length;
      const buildingCount=state.assets.filter(a=>itemMap[a.itemId].kind==="building").length;
      const eventTotal=state.stats.eventsCorrect+state.stats.eventsWrong;
      const eventRate=eventTotal?Math.round(state.stats.eventsCorrect/eventTotal*100):0;
      const comments=[];

      if(metrics.balance>=30){
        comments.push("คุณสร้างส่วนสำรองด้านคาร์บอนได้ดี เมืองจึงรองรับความเสี่ยงจากเหตุการณ์ฉุกเฉินได้มาก");
      }else if(metrics.balance>=0){
        comments.push("คุณรักษา Net Zero ได้ แต่ส่วนต่างคาร์บอนค่อนข้างต่ำ ควรเพิ่มพื้นที่สีเขียวก่อนขยายอาคารครั้งต่อไป");
      }else{
        comments.push("การปล่อยสูงกว่าการดูดซับ ควรชะลอการขยายอาคารและเพิ่มพื้นที่สีเขียว");
      }

      if(buildingCount>treeCount){
        comments.push("โครงสร้างเมืองเน้นเศรษฐกิจมากกว่าพื้นที่สีเขียว ควรกระจายต้นไม้และสร้างทางเชื่อมสีเขียวเพิ่มเติม");
      }else{
        comments.push("เมืองมีสัดส่วนต้นไม้ที่ดี ควรรักษาความหลากหลายของชนิดและกระจายร่มเงาให้ประชาชนเข้าถึงได้");
      }

      comments.push(eventRate>=70
        ?`คุณตอบสถานการณ์พิเศษถูก ${eventRate}% แสดงถึงความเข้าใจเรื่องพื้นที่สีเขียวในระดับดี`
        :`คุณตอบสถานการณ์พิเศษถูก ${eventRate}% ควรทบทวนข้อที่เกี่ยวกับการคำนวณคาร์บอนและการวางผังเมือง`);

      return comments.join(" ");
    }

    function finishGame(gameOver,reason){
      if(state.ended)return;

      state.ended=true;
      state.paused=true;
      clearInterval(timer);
      closeModal();
      clearSelection();

      const metrics=getMetrics();
      const treesNow=state.assets.filter(a=>itemMap[a.itemId].kind==="tree").length;
      const buildingsNow=state.assets.filter(a=>itemMap[a.itemId].kind==="building").length;
      const score=calculateGameScore();

      result.gameScore=score;
      result.gameSummary=
        `เงินคงเหลือ ${money(state.cash)} | สมดุลคาร์บอน ${metrics.balance>=0?"+":""}${metrics.balance} | `+
        `ต้นไม้ ${treesNow} | อาคาร ${buildingsNow} | เหตุการณ์ตอบถูก ${state.stats.eventsCorrect}`;

      $("#gameResult").innerHTML=`
        <div style="text-align:center">
          <div style="font-size:3.4rem">${gameOver?"😵":"🎉"}</div>
          <h2>${gameOver?"Game Over":"ภารกิจสร้างกรุงเทพฯ สำเร็จ"}</h2>
          <p>${escapeHTML(reason)}</p>
          <div class="score-number" style="font-size:4.2rem">${score.toLocaleString("th-TH")}</div>
          <strong>คะแนนเกม</strong>
        </div>

        <div class="identity" style="text-align:center">${escapeHTML(identity())}</div>

        <div class="summary-grid">
          <div class="summary-box"><small>เงินคงเหลือ</small><strong>${money(state.cash)}</strong></div>
          <div class="summary-box"><small>สมดุลคาร์บอน</small><strong>${metrics.balance>=0?"+":""}${metrics.balance}</strong></div>
          <div class="summary-box"><small>ต้นไม้คงเหลือ</small><strong>${treesNow}</strong></div>
          <div class="summary-box"><small>อาคารคงเหลือ</small><strong>${buildingsNow}</strong></div>
          <div class="summary-box"><small>รายได้ทั้งหมด</small><strong>${money(state.stats.incomeEarned)}</strong></div>
          <div class="summary-box"><small>เงินลงทุน</small><strong>${money(state.stats.spent)}</strong></div>
          <div class="summary-box"><small>เหตุการณ์ตอบถูก</small><strong>${state.stats.eventsCorrect}</strong></div>
          <div class="summary-box"><small>ทรัพย์สินเสียหาย</small><strong>${state.stats.destroyed}</strong></div>
        </div>

        <div class="ai-box">
          <h3>🤖 สรุปการเล่นแบบอัจฉริยะ</h3>
          <p>${escapeHTML(intelligentSummary())}</p>
          <div class="small" style="color:#d7eae2">
            ประมวลผลภายในอุปกรณ์จากสถิติของเกม ไม่มีการส่งข้อมูลส่วนบุคคลออกภายนอก
          </div>
        </div>

        <div class="notice warning" style="margin-top:19px">
          <strong>กรุณาถ่ายภาพหน้าจอสถิตินี้เก็บไว้</strong><br>
          ข้อมูลจะหายไปเมื่อปิดหรือรีเฟรชหน้าเว็บ
        </div>

        <div class="actions">
          <button id="printGameResult" class="btn">🖨️ บันทึก/พิมพ์สถิติ</button>
          <button id="openPostTest" class="btn primary">ทำ Post-test →</button>
        </div>
      `;

      showScreen("gameResultScreen");
      $("#printGameResult").onclick=()=>window.print();
      $("#openPostTest").onclick=()=>openQuiz("post");
    }

    function renderFinalResult(){
      const improvement=result.postScore-result.preScore;
      const percentage=Math.round(result.postScore/questions.length*100);

      const reviews=questions.map((q,i)=>{
        const correct=result.postAnswers[i]===q.a;
        return `
          <article class="answer-review ${correct?"correct":"wrong"}">
            <h3>${i+1}. ${escapeHTML(q.q)}</h3>
            <p><strong>คำตอบของคุณ:</strong> ${escapeHTML(q.c[result.postAnswers[i]])}</p>
            <p><strong>คำตอบที่ถูก:</strong> ${escapeHTML(q.c[q.a])}</p>
            <p><strong>คำอธิบาย:</strong> ${escapeHTML(q.e)}</p>
          </article>
        `;
      }).join("");

      const summaryText=
        `ชื่อ-นามสกุล: ${user.name}\n`+
        `ชั้น: ${user.studentClass} เลขที่: ${user.number}\n`+
        `คะแนน Pre-test: ${result.preScore}/${questions.length}\n`+
        `คะแนน Post-test: ${result.postScore}/${questions.length}\n`+
        `คะแนนเกม: ${result.gameScore.toLocaleString("th-TH")}\n`+
        `สถิติเกม: ${result.gameSummary}`;

      $("#finalResult").innerHTML=`
        <div class="panel score-card">
          <div class="result-mark" id="finalMark">
            <img src="${SCHOOL_LOGO}" alt="ตราโรงเรียน"
                 onerror="this.remove();document.getElementById('finalMark').classList.add('no-logo')">
          </div>
          <div style="font-size:3rem">🎊</div>
          <h1 style="font-size:2.3rem">เสร็จสิ้นภารกิจ เย่!</h1>
          <div class="identity">${escapeHTML(identity())}</div>

          <div class="summary-grid">
            <div class="summary-box"><small>Pre-test</small><strong>${result.preScore}/${questions.length}</strong></div>
            <div class="summary-box"><small>Post-test</small><strong>${result.postScore}/${questions.length}</strong></div>
            <div class="summary-box"><small>การเปลี่ยนแปลง</small><strong>${improvement>=0?"+":""}${improvement}</strong></div>
            <div class="summary-box"><small>คะแนนเกม</small><strong>${result.gameScore.toLocaleString("th-TH")}</strong></div>
          </div>

          <div class="bar"><span style="width:${percentage}%"></span></div>
          <p class="small" style="margin-top:8px">ทำ Post-test ได้ ${percentage}% ของคะแนนเต็ม</p>

          <div class="notice warning" style="text-align:left;margin-top:18px">
            <strong>กรุณาถ่ายภาพหน้าจอนี้ก่อนกรอกฟอร์ม</strong><br>
            ระบบไม่จัดเก็บข้อมูล หากปิดหรือรีเฟรชหน้าเว็บจะไม่สามารถเรียกคะแนนกลับมาได้
          </div>

          <div class="copy-box" id="summaryText">${escapeHTML(summaryText)}</div>

          <div class="actions">
            <button id="copySummary" class="btn">📋 คัดลอกสรุปคะแนน</button>
            <button id="printFinal" class="btn">🖨️ บันทึก/พิมพ์ผล</button>
            <button id="scrollToForm" class="btn form">📄 ไปที่ฟอร์มส่งคะแนน ↓</button>
          </div>
        </div>

        <div class="panel form-panel" id="formPanel">
          <div class="form-head">
            <span class="form-badge">ขั้นตอนสุดท้าย</span>
            <h2>กรอกคะแนนในฟอร์ม</h2>
          </div>

          <div class="checklist">
            <strong>ก่อนกรอก ตรวจสอบให้ครบ</strong>
            <ol>
              <li>ถ่ายภาพหน้าจอคะแนน Pre-test สถิติเกม และคะแนน Post-test แล้ว</li>
              <li>กดปุ่ม <strong>คัดลอกสรุปคะแนน</strong> ด้านบนเพื่อวางลงฟอร์มได้สะดวก</li>
              <li>กรอกฟอร์มด้านล่างนี้ให้ครบแล้วกดส่งภายในหน้านี้ได้เลย</li>
            </ol>
          </div>

          <div class="form-frame-wrap" id="formWrap">
            <div class="form-placeholder" id="formPlaceholder">
              <div class="icon">📄</div>
              <strong>แบบฟอร์มบันทึกคะแนน ส30105</strong>
              <p class="small" style="max-width:430px">
                กดปุ่มด้านล่างเพื่อโหลดฟอร์มมาแสดงในหน้านี้ โดยไม่ต้องเปิดแท็บใหม่
              </p>
              <button id="loadForm" class="btn form">โหลดฟอร์มที่นี่</button>
            </div>
          </div>

          <div class="form-fallback">
            หากฟอร์มไม่แสดงผลในกรอบด้านบน (เบราว์เซอร์บางรุ่นบล็อกการฝัง)
            ให้เปิดผ่านลิงก์นี้แทน:
            <a href="${CONFIG.SUBMISSION_URL}" target="_blank" rel="noopener">${CONFIG.SUBMISSION_URL}</a>
          </div>
        </div>

        <div class="panel">
          <h2>เฉลยและคำอธิบาย</h2>
          ${reviews}
        </div>

        <div class="panel small" style="line-height:1.7">
          <h3>ข้อจำกัดของแบบจำลอง</h3>
          <p>
            แผนที่กรุงเทพฯ อาคาร แลนด์มาร์ก ค่าการดูดซับคาร์บอน และการปล่อยของอาคารในเกม
            เป็นแบบจำลองเพื่อการเรียนรู้ ไม่ใช่แผนที่มาตราส่วนจริง
            และไม่ใช่ผลการประเมินคาร์บอนฟุตพรินต์ที่ใช้รับรองอย่างเป็นทางการ
          </p>
          <p>
            การประเมินจริงต้องใช้ข้อมูลชนิดและขนาดต้นไม้ สุขภาพ อัตรารอด การใช้ไฟฟ้า
            เชื้อเพลิง สารทำความเย็น และค่า Emission Factor ที่ตรงกับพื้นที่และช่วงเวลา
          </p>
        </div>
      `;

      $("#printFinal").onclick=()=>window.print();

      $("#scrollToForm").onclick=()=>{
        $("#formPanel").scrollIntoView({behavior:"smooth",block:"start"});
        if($("#loadForm"))setTimeout(loadEmbeddedForm,420);
      };

      $("#loadForm").onclick=loadEmbeddedForm;

      $("#copySummary").onclick=async()=>{
        try{
          await navigator.clipboard.writeText(summaryText);
          showToast("คัดลอกสรุปคะแนนแล้ว");
        }catch(error){
          const range=document.createRange();
          range.selectNodeContents($("#summaryText"));
          const selection=window.getSelection();
          selection.removeAllRanges();
          selection.addRange(range);
          showToast("กรุณากดคัดลอกข้อความที่เลือกไว้");
        }
      };
    }

    function loadEmbeddedForm(){
      const wrap=$("#formWrap");
      if(!wrap||wrap.dataset.loaded==="1")return;

      wrap.dataset.loaded="1";
      wrap.innerHTML=`
        <iframe id="formFrame"
                src="${FORM_EMBED_URL}"
                loading="lazy"
                title="แบบฟอร์มบันทึกคะแนน ส30105">
          กำลังโหลดฟอร์ม…
        </iframe>
      `;
      showToast("กำลังโหลดฟอร์ม กรุณารอสักครู่");
    }

    window.addEventListener("beforeunload",event=>{
      if(user.name&&!$("#finalScreen").classList.contains("active")){
        event.preventDefault();
        event.returnValue="";
      }
    });
  </script>
</body>
</html>
    function riverXAtZ(z){
      let nearest=riverPoints[0];
      let difference=Infinity;

      riverPoints.forEach(point=>{
        const current=Math.abs(point.z-z);
        if(current<difference){
          difference=current;
          nearest=point;
        }
      });

      return nearest.x;
    }

    function distanceToRiver(x,z){
      let minimum=Infinity;

      for(let i=0;i<riverPoints.length-1;i++){
        const a=riverPoints[i];
        const b=riverPoints[i+1];
        const abx=b.x-a.x;
        const abz=b.z-a.z;
        const lengthSquared=abx*abx+abz*abz;
        const t=Math.max(0,Math.min(1,((x-a.x)*abx+(z-a.z)*abz)/lengthSquared));
        minimum=Math.min(minimum,Math.hypot(x-(a.x+t*abx),z-(a.z+t*abz)));
      }

      return minimum;
    }

    function resizeRenderer(){
      if(!renderer||!camera)return;
      const container=$("#threeContainer");
      const width=Math.max(1,container.clientWidth);
      const height=Math.max(1,container.clientHeight);
      renderer.setSize(width,height,false);
      camera.aspect=width/height;
      camera.updateProjectionMatrix();
    }

    function animate(){
      requestAnimationFrame(animate);

      if(renderer&&scene&&camera){
        const elapsed=clock?clock.getElapsedTime():0;

        cityRoot?.children.forEach(child=>{
          if(child.userData.water){
            child.position.y=.2+Math.sin(elapsed*1.7+child.position.z*.08)*.035;
          }
        });

        controls?.update();
        renderer.render(scene,camera);
      }
    }

    window.addEventListener("resize",resizeRenderer);

    $("#resetCamera").addEventListener("click",()=>{
      if(!camera||!controls)return;
      camera.position.set(112,88,112);
      controls.target.set(0,3,0);
      controls.update();
    });

    $("#toggleRotate").addEventListener("click",()=>{
      autoRotate=!autoRotate;
      controls.autoRotate=autoRotate;
      $("#toggleRotate").textContent=autoRotate?"⏸️ หยุดหมุน":"🔄 หมุนอัตโนมัติ";
    });

    function setupMapInteraction(){
      const canvas=renderer.domElement;

      canvas.addEventListener("pointerdown",event=>{
        pointerDown={x:event.clientX,y:event.clientY};
      });

      canvas.addEventListener("pointerup",event=>{
        if(!pointerDown||state.paused||state.ended)return;

        const distance=Math.hypot(event.clientX-pointerDown.x,event.clientY-pointerDown.y);
        pointerDown=null;
        if(distance>7)return;

        const assetId=pickAsset(event.clientX,event.clientY);
        if(assetId){
          inspectAsset(assetId);
          return;
        }

        if(selectedItemId){
          const point=groundPoint(event.clientX,event.clientY);
          if(point)attemptPlacement(selectedItemId,point.x,point.z);
        }
      });

      canvas.addEventListener("dragover",event=>event.preventDefault());
      canvas.addEventListener("drop",event=>{
        event.preventDefault();
        if(state.paused||state.ended)return;

        const id=event.dataTransfer.getData("text/plain");
        if(!itemMap[id])return;

        const point=groundPoint(event.clientX,event.clientY);
        if(point)attemptPlacement(id,point.x,point.z);
      });
    }

    function screenPointer(clientX,clientY){
      const rect=renderer.domElement.getBoundingClientRect();
      return new THREE.Vector2(
        ((clientX-rect.left)/rect.width)*2-1,
        -((clientY-rect.top)/rect.height)*2+1
      );
    }

    function groundPoint(clientX,clientY){
      raycaster.setFromCamera(screenPointer(clientX,clientY),camera);
      const hit=raycaster.intersectObject(placementPlane,false)[0];
      return hit?hit.point:null;
    }

    function pickAsset(clientX,clientY){
      raycaster.setFromCamera(screenPointer(clientX,clientY),camera);
      const hits=raycaster.intersectObjects(userRoot.children,true);

      for(const hit of hits){
        let object=hit.object;
        while(object){
          if(object.userData.assetId)return object.userData.assetId;
          object=object.parent;
        }
      }

      return null;
    }

